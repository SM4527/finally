# Required: at least one of these (Groq primary, OpenRouter fallback)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data; empty = simulator
MASSIVE_API_KEY=
# Optional: seconds between Massive polls (default 15 = free-tier safe)
MASSIVE_POLL_INTERVAL=

# Optional: "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false
